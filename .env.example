# Price API Configuration
PRICE_API_URL=https://price.mudrex.com
WS_URL=wss://price.mudrex.com/api/v1/klines

# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Assets to monitor (comma-separated)
ASSETS=BTC,ETH,SOL

# Quote currency
QUOTE_CURRENCY=USDT

# Price thresholds (JSON format)
# Example: {"BTC":[85000,90000,100000],"ETH":[3500,4000]}
PRICE_THRESHOLDS={"BTC":[85000,88000,90000,100000],"ETH":[3500,3700,4000],"SOL":[200,250]}

# Volume spike multiplier (alert when volume > X times average)
VOLUME_SPIKE_MULTIPLIER=2.5

# Price spike percentage (alert on sudden % change)
PRICE_SPIKE_PERCENT=5.0
